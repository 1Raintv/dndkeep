# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (public key only — secret key goes on the server/edge function)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# Stripe Price IDs
# The subscription, then the six one-time products. All seven must exist in Stripe
# before the Store can sell anything — an unset price ID renders that product
# with a disabled "coming soon" button (see isPriceConfigured in lib/stripe.ts).
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_your-price-id-here
VITE_STRIPE_CHARACTER_SLOT_PRICE_ID=price_your-price-id-here
VITE_STRIPE_CAMPAIGN_SLOT_PRICE_ID=price_your-price-id-here
VITE_STRIPE_ULTIMATE_CAMPAIGN_PRICE_ID=price_your-price-id-here
# Dice sets — the env name, the product_key, the dice_skin_unlocks.skin_id and
# the id in src/data/diceSkins.ts all read "crimson"/"emerald"/"sapphire".
VITE_STRIPE_DICE_CRIMSON_PRICE_ID=price_your-price-id-here
VITE_STRIPE_DICE_EMERALD_PRICE_ID=price_your-price-id-here
VITE_STRIPE_DICE_SAPPHIRE_PRICE_ID=price_your-price-id-here

# App
VITE_APP_URL=http://localhost:5173

# Optional — Giphy (campaign chat GIF picker). Leave unset to hide
# the GIF button entirely. Free key from developers.giphy.com.
# VITE_GIPHY_API_KEY=your-giphy-key-here
