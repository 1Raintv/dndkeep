# OPTIONAL — local Supabase override (v2.638).
#
# Copy to `.env.local` (gitignored) to point YOUR machine at a local
# Docker Supabase instead of production. Machines without a .env.local
# behave exactly as before: .env -> production. Vite's precedence does
# the switching (.env.local overrides .env); no code involved.
#
# Bring-up (needs Docker + the Supabase CLI):
#   supabase start          # first run downloads images; prints the keys
#   supabase db reset       # applies ./supabase/migrations to the local DB
#
# `supabase start` prints "API URL" and "anon key" — paste them below.
# The demo anon key is the same for every local install; it is NOT a secret.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-printed-by-supabase-start
VITE_APP_URL=http://localhost:5173
