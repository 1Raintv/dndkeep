# OPTIONAL — local Supabase override (v2.638).
#
# Copy this file to `.env.local` (gitignored) to point YOUR machine at a
# local Docker Supabase instead of production. Machines without a
# .env.local behave exactly as before: .env -> production. Vite's
# precedence does the switching (.env.local overrides .env); no code
# involved. Delete .env.local to switch back.
#
# Quickstart (Docker Desktop running; supabase CLI is already a
# devDependency of this repo):
#   npx supabase start     # first run downloads images (a few GB)
#   npx supabase db reset  # migrations + seed (test login below)
#   copy .env.local.example .env.local
#   npm run dev
#
# Seeded login: test-dm@dndkeep.local / dndkeep-local-test  (Pro, owns
# "Local Test Campaign"). See e2e/README.md for the E2E test tiers.
#
# The anon key below is Supabase's standard LOCAL demo key — identical
# on every machine because supabase/config.toml uses the default local
# JWT secret. It is NOT a secret and grants nothing outside 127.0.0.1.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_APP_URL=http://localhost:5173
