node_modules
dist
dist-ssr
*.local

# Environment variables — never commit these
#
# v2.683.0 — `.env.production` was NOT covered by these rules and is currently
# tracked. It holds only placeholders today (pk_test_placeholder /
# price_placeholder), which is the only reason that has been survivable. Live
# Stripe keys go in the Vercel dashboard and must never be written to a file in
# this repo — see docs/MVP_LAUNCH.md Phase 2 item 6.
#
# Not ignored retroactively here: adding it while the file is still tracked
# changes nothing (git keeps tracking it) and would give a false sense that it
# is protected. Untrack it first — `git rm --cached .env.production` — then
# uncomment the line below.
# .env.production
.env
.env.local
.env.*.local

# Supabase local dev
supabase/.temp
supabase/.branches

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.vs/

# TypeScript
*.tsbuildinfo

# Claude Code — local agent state is ignored, but the repo SHIPS a
# .claude/ toolkit (skills, audit docs, launch config) for anyone
# pointing Claude at this codebase — see .claude/README.md.
.claude/settings.local.json
.claude/worktrees/

# Vercel CLI — links this checkout to the Vercel project, do not share
.vercel/

# Deploy script scratch output
deploy.lock
deploy-log.txt
deploy.log
*.tmp
*.patch

# Editor/manual backup copies. deploy.bat runs `git add .`, so an ignore
# pattern is the only thing that reliably stops these getting committed —
# FeaturesPanel.tsx.bak survived tracked for months as a stale duplicate of
# a live component, exactly the "duplicate-file drift" hazard in CLAUDE.md.
*.bak
*.old
*.orig
*.rej
*~

# Playwright — run artifacts (baselines in e2e/__screenshots__ ARE committed)
test-results/
playwright-report/
